packages:
    kda-tool.cabal
    ../signing-api/kadena-signing-api/kadena-signing-api.cabal
with-compiler: ghc-9.12.2

package pact
    ghc-options: -Wwarn
    -- avoid conflict with cryptonite during linking
    flags: +cryptonite-ed25519 -build-tool +no-advice

package cryptonite-openssl
    extra-lib-dirs: /opt/homebrew/opt/openssl@3/lib
    extra-include-dirs: /opt/homebrew/opt/openssl@3/include

package hashes
    flags: +with-openssl +openssl-use-pkg-config
    extra-lib-dirs: /opt/homebrew/opt/openssl@3/lib
    extra-include-dirs: /opt/homebrew/opt/openssl@3/include

package ethereum
    flags: +openssl-use-pkg-config
    extra-lib-dirs: /opt/homebrew/opt/openssl@3/lib
    extra-include-dirs: /opt/homebrew/opt/openssl@3/include

source-repository-package
    type: git
    location: https://github.com/vootaa/cardano-crypto.git
    tag: 4590efa638397e952a51a8994b5543e4ea3c1ecd
    --sha256: 0hl2n3bba5v2j0lmxhs7hs01z3aznh2bwf9cb434icq2g0bl8ms3

source-repository-package
    type: git
    location: https://github.com/vootaa/chainweb-api.git
    tag: 1b2de025cfdc09698bfb1ec3807cd85405d6a339
    --sha256: 1m9x9n5mwmv97fkv2z3hvlhlj59xm2mpsc816hzriw28pv1jb9zh

source-repository-package
    type: git
    location: https://github.com/pcapriotti/optparse-applicative
    tag: 9399fd0f745e4d4d71e8bba03d402648b767363c
    --sha256: 0gkgccix898mafrs25fajqwxbb7zmg30livrj7b79knd6a5sqj76

source-repository-package
    type: git
    location: https://github.com/vootaa/pact.git
    tag: 4208012e3f2fdf1721c24cdcb97de5f64fd5f58a
    --sha256: 0l59xi2by6l6gi10r8c437m7ics29215zr0zl1syyr3039vgmv0x

source-repository-package
    type: git
    location: https://github.com/vootaa/pact-json.git
    tag: 1d260bfaa48312b54851057885de4c43c420e35f
    --sha256: 0fzq4mzaszj5clvixx9mn1x6r4dcrnwvbl2znd0p5mmy5h2jr0hh

source-repository-package
    type: git
    location: https://github.com/vootaa/kadena-ethereum-bridge.git
    tag: 96bff6b35b2a2b6bf63f9d19b536f0c61102be36
    --sha256: 0czl48hhlk8fl63jprg719x3ngrinhj6xs5rqm9cfzpcygp4wz4q

allow-newer: hashable:base
allow-newer: chainweb-api:aeson
allow-newer: chainweb-api:vector
allow-newer: chainweb-api:servant
allow-newer: chainweb-api:bytestring
allow-newer: chainweb-api:*
allow-newer: servant:bifunctors
allow-newer: kadena-signing-api:text
allow-newer: kadena-signing-api:lens
allow-newer: kadena-signing-api:*
allow-newer: *:base
allow-newer: *:aeson
allow-newer: *:hashable
allow-newer: *:unordered-containers
allow-newer: *:template-haskell
allow-newer: *:bifunctors

-- bounds from pact
constraints: prettyprinter <2
constraints: tls <2
constraints: lens >=5.3
